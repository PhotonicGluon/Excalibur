{
    "name": "excalibur",
    "version": "0.3.0-alpha.12",
    "description": "A trustless, secure file management solution using military-grade encryption",
    "homepage": "https://github.com/PhotonicGluon/Excalibur",
    "bugs": {
        "url": "https://github.com/PhotonicGluon/Excalibur/issues"
    },
    "license": "GPL-3.0-or-later",
    "author": {
        "name": "PhotonicGluon",
        "email": "25820201+PhotonicGluon@users.noreply.github.com",
        "url": "https://github.com/PhotonicGluon"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PhotonicGluon/Excalibur.git"
    },
    "main": "out/main.mjs",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite --port 8100",
        "dev:electron": "electron-vite dev",
        "preview": "vite preview",
        "preview:electron": "electron-vite preview",
        "build": "npx vite build && npx cap copy",
        "build:electron": "electron-vite build",
        "build:electron:unpack": "electron-vite build && electron-builder --dir --config",
        "build:electron:win": "electron-vite build && electron-builder --win --config",
        "build:electron:mac": "electron-vite build && electron-builder --mac --config",
        "build:electron:linux": "electron-vite build && electron-builder --linux --config",
        "sync": "npx cap sync --inline",
        "cy:open": "cypress open",
        "cy:run": "cypress run",
        "test:unit": "vitest watch",
        "test:unit-run": "vitest run",
        "test:component": "cypress run --component",
        "lint": "eslint --max-warnings 0 --fix --no-warn-ignored",
        "update": "npx npm-check-updates --peer -u"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-cypress": "^5.2.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10"
    },
    "private": true,
    "lint-staged": {
        "*.{ts,tsx}": "pnpm run lint"
    }
}
