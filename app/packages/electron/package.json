{
    "name": "excalibur-electron",
    "main": "out/main.mjs",
    "type": "module",
    "scripts": {
        "dev": "electron-vite dev",
        "preview": "electron-vite preview",
        "build": "electron-vite build",
        "build:unpack": "pnpm run build && electron-builder --dir --config electron-builder.config.js",
        "build:win": "pnpm run build && electron-builder --win --config electron-builder.config.js",
        "build:mac": "pnpm run build && electron-builder --mac --config electron-builder.config.js",
        "build:linux": "pnpm run build && electron-builder --linux --config electron-builder.config.js"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "electron-updater": "^6.6.2"
    },
    "devDependencies": {
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@tailwindcss/vite": "^4.1.17",
        "@vitejs/plugin-legacy": "^7.2.1",
        "@vitejs/plugin-react": "^5.1.1",
        "dmg-builder": "^26.3.1",
        "electron": "^39.2.4",
        "electron-builder": "^26.3.1",
        "electron-builder-squirrel-windows": "^26.3.1",
        "electron-vite": "^4.0.1",
        "vite": "~7.2.4",
        "vite-plugin-node-polyfills": "^0.24.0"
    },
    "private": true
}
